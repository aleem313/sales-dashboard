# Postgres (self-hosted on Contabo; in dev point at a local Postgres 17)
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Google Sheets (for job_log import)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Webhook security
N8N_WEBHOOK_SECRET=

# Cron / migrate-route shared secret
CRON_SECRET=

# Auth (NextAuth.js v5 + GitHub OAuth)
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_EMAILS=
# Credentials login: email:password pairs, comma-separated
ADMIN_CREDENTIALS=

# Slack alerts (optional — alerts logged to console if missing)
SLACK_WEBHOOK_URL=

# n8n integration (optional — for auto-provisioning webhook nodes)
N8N_API_URL=
N8N_API_KEY=

# Task-attachment storage. In production this is a mounted Docker volume
# (see docker-compose.server.yml). Defaults to ./uploads in local dev.
UPLOADS_DIR=

# Public app origin (used by server actions that call back into our own API)
NEXT_PUBLIC_APP_URL=
