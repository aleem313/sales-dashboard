# ============================================
# Contabo server deployment env (HTTP-only, no domain)
# Copy this file to .env.production on the server and fill in real values.
# ============================================

# --- PostgreSQL (inside Docker network) ---
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DATABASE=sales_dashboard
POSTGRES_HOST=postgres
POSTGRES_URL=postgresql://sales_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sales_dashboard
POSTGRES_URL_NON_POOLING=postgresql://sales_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/sales_dashboard

# --- NextAuth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
AUTH_URL=http://157.173.110.62
# Optional — only if you want GitHub OAuth login on the server.
# GitHub OAuth app callback URL must be: http://157.173.110.62/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_EMAILS=your-email@example.com
ADMIN_CREDENTIALS=admin@example.com:CHANGE_ME_ADMIN_PASSWORD

# --- Webhook security ---
# HMAC secret that must match the value used in the n8n HTTP node that
# posts to /api/webhook/n8n on this server.
N8N_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# --- Cron security ---
# Used by /api/migrate and any future cron endpoints.
CRON_SECRET=CHANGE_ME_CRON_SECRET

# --- n8n integration (for profile sync from the dashboard UI) ---
N8N_API_URL=https://ikonicdev.app.n8n.cloud
N8N_API_KEY=

# --- Optional: Google Sheets import ---
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# --- Optional: Slack alerts ---
SLACK_WEBHOOK_URL=
