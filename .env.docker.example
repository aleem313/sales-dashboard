# ============================================
# Docker Environment Variables
# Copy to .env.local (dev) or .env.production (prod)
# ============================================

# PostgreSQL — these are used by BOTH the PG container and the app
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DATABASE=sales_dashboard
POSTGRES_HOST=postgres
POSTGRES_URL=postgresql://sales_user:change_me_to_a_strong_password@postgres:5432/sales_dashboard
POSTGRES_URL_NON_POOLING=postgresql://sales_user:change_me_to_a_strong_password@postgres:5432/sales_dashboard

# Auth (NextAuth.js v5)
AUTH_SECRET=generate_with_openssl_rand_base64_32
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_EMAILS=admin@example.com
ADMIN_CREDENTIALS=admin@example.com:your_admin_password

# Webhook security
N8N_WEBHOOK_SECRET=generate_a_random_secret

# Cron security
CRON_SECRET=generate_a_random_secret

# Google Sheets (optional)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Slack alerts (optional)
SLACK_WEBHOOK_URL=

# n8n integration (optional)
N8N_API_URL=
N8N_API_KEY=
