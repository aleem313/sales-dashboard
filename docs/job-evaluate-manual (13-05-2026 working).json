      "id": "j2-validate",
      "name": "J2 - Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1000, 0],
      "parameters": {
        "jsCode": "// J2 — Validate Input (plan v3.3 §4.3)\n// Confirms task_id is a UUID and profile_id is non-empty. Throws on failure\n// → n8n returns 500. The dashboard's /api/relevancy/evaluate-task route\n// already pre-validates, so this is defense-in-depth.\n\nconst body = items[0].json.body ?? items[0].json;\nconst taskId = body.task_id;\nconst profileId = body.profile_id;\nconst requestedBy = body.requested_by ?? null;\nconst requestId = body.request_id ?? null;\n\nconst UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!taskId || typeof taskId !== 'string' || !UUID_RE.test(taskId)) {\n  throw new Error(`Invalid task_id: ${taskId}`);\n}\nif (!profileId || typeof profileId !== 'string') {\n  throw new Error(`Missing profile_id`);\n}\n\nreturn [{\n  json: {\n    task_id: taskId.toLowerCase(),\n    profile_id: profileId,\n    requested_by: requestedBy,\n    request_id: requestId,\n  },\n}];"
      }
    },
