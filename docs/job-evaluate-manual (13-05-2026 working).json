      "id": "j3-load-task",
      "name": "J3 - Load Task Card",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-800, 0],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "=http://157.173.110.62/api/tasks/{{ $json.task_id }}/job-payload",
        "options": { "timeout": 10000 }
      }
