# =============================================================
# RELEVANCY SCORING SYSTEM (v3.1) — env vars
# Reference: docs/upwork-relevancy-scoring-ai-plan-v3.md §15
#
# This file is a STAGING template for the new vars introduced
# by the relevancy scoring system. Once values are filled in
# and reviewed, merge the contents into:
#   - .env.example     (placeholders only, committed to git)
#   - .env.local       (local dev with real values, gitignored)
#   - Contabo .env.production (real values, on the VPS)
#
# Do NOT commit real secrets to this file.
# =============================================================


# -------------------------------------------------------------
# APIFY (Upwork scraper) — primary scrape provider
# -------------------------------------------------------------
# Get from: https://console.apify.com/account/integrations
# Free signup; needs $5+ credit on the account for cron stability.
APIFY_TOKEN=apify_api_REPLACE_ME

# Apify actor IDs — fill in AFTER the Phase 3 spike (build plan
# Appendix B Phase 3) picks the winning profile + job actors.
# Format: <username>~<actor-name>
# Candidates per build plan §5.1:
#   apify~upwork-public-profile-scraper
#   epctex~upwork-scraper
APIFY_PROFILE_ACTOR_ID=
APIFY_JOB_ACTOR_ID=

# Per-URL scrape cache TTL (seconds). 0 = no cache.
# Build plan default: 3600 for profiles, 0 for jobs
# (fresh proposal counts matter for the auto-pipeline gate 3).
APIFY_PROFILE_CACHE_TTL=3600
APIFY_JOB_CACHE_TTL=0


# -------------------------------------------------------------
# GEMINI (relevancy classifier LLM)
# -------------------------------------------------------------
# Get from: https://aistudio.google.com/apikey
# Free tier: 15 RPM / 1M tokens-per-day — enough for our volume.
# Build plan §11.1 projects ~$8/mo at 10x baseline.
GEMINI_API_KEY=AIza_REPLACE_ME
GEMINI_MODEL=gemini-2.5-flash


# -------------------------------------------------------------
# WEBHOOK AUTH TOKENS — generate via: openssl rand -hex 32
# -------------------------------------------------------------
# These are the Bearer tokens n8n uses to authenticate inbound
# calls FROM the dashboard. The SAME value must be set in
# n8n's "Header Auth" credential for each new webhook node.
#
# Generate three independent values; do not reuse across endpoints.
#
# Bash / WSL / macOS:    openssl rand -hex 32
# PowerShell:            -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
PROFILE_INGEST_TOKEN=REPLACE_ME_64_HEX_CHARS
PROFILE_SYNC_TOKEN=REPLACE_ME_64_HEX_CHARS
MANUAL_EVAL_TOKEN=REPLACE_ME_64_HEX_CHARS


# -------------------------------------------------------------
# CRITERIA + KILL-SWITCH
# -------------------------------------------------------------
# Must match the `version` field in docs/job_relevancy_criteria_prd.md
# and the latest row in the criteria_versions table (migration 017).
CRITERIA_PRD_VERSION=0.2

# Master kill-switch for the classifier (build plan §13.5).
# Set to "false" to revert to v2-pre-classifier behavior in <30s
# without a redeploy. The IF node before `Score Relevancy` reads this.
# Default: true (classifier active). Flip to false during incidents.
RELEVANCY_CLASSIFIER_ENABLED=true


# -------------------------------------------------------------
# COST GUARDS (build plan §16.3 R3, R4)
# -------------------------------------------------------------
# Daily Apify spend cap (USD). When exceeded, /api/relevancy/evaluate
# returns 429 with "Daily Apify budget exhausted." Cron sync continues
# (it has its own per-profile rate limit via splitInBatches).
APIFY_DAILY_BUDGET_USD=5

# Daily Gemini token soft cap. Alert fires at 80% of this value.
# 0 = no cap. Default 1M matches the free-tier daily quota.
GEMINI_DAILY_TOKEN_CAP=1000000


# -------------------------------------------------------------
# RATE LIMITING BACKEND (pick ONE — build plan §16.3 R1, R2)
# -------------------------------------------------------------
# Option A — Postgres-backed (recommended; no extra service)
RATE_LIMIT_BACKEND=postgres

# Option B — Upstash Redis (lower latency at scale; requires account)
# Get URLs from: https://console.upstash.com → create Redis DB
# RATE_LIMIT_BACKEND=upstash
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=


# -------------------------------------------------------------
# DLQ (build plan §16.4 I2)
# -------------------------------------------------------------
# When a relevancy_scores write fails after retries, the verdict
# is parked in this DLQ table for manual replay. Existing infra
# can reuse the table created by migration 017.
RELEVANCY_DLQ_RETRY_INTERVAL_SECONDS=30
RELEVANCY_DLQ_MAX_RETRIES=10


# -------------------------------------------------------------
# ALREADY EXISTS — DO NOT DUPLICATE
# -------------------------------------------------------------
# These vars are already in your .env.example and are reused
# by the relevancy system. Just verify they're set in production.
#
# N8N_WEBHOOK_SECRET    — HMAC secret for n8n → dashboard callbacks
# N8N_API_URL           — https://ikonicdev.app.n8n.cloud/api/v1
# N8N_API_KEY           — n8n cloud API key (already in dashboard env)
# CRON_SECRET           — used by /api/migrate route
# SLACK_WEBHOOK_URL     — reused for relevancy alerts (L5)
# AUTH_SECRET           — NextAuth.js
# POSTGRES_URL          — Contabo Postgres connection string


# =============================================================
# n8n CLOUD ENV VARS (set inside n8n, NOT in this file)
# =============================================================
# n8n cloud has its own env-var UI at Settings → Variables.
# Set these on the ikonicdev.app.n8n.cloud instance with the
# SAME values you use here:
#
#   APIFY_TOKEN
#   APIFY_PROFILE_ACTOR_ID
#   APIFY_JOB_ACTOR_ID
#   GEMINI_API_KEY
#   GEMINI_MODEL
#   RELEVANCY_CLASSIFIER_ENABLED
#   CRITERIA_PRD_VERSION
#
# The PROFILE_INGEST_TOKEN / PROFILE_SYNC_TOKEN / MANUAL_EVAL_TOKEN
# values are stored as n8n CREDENTIALS (type: Header Auth) on the
# new webhook nodes — not as env vars. One credential per webhook.
#
# The dashboard callback Bearer (n8n-board-sync) is already
# configured per CLAUDE.md — do NOT mint a new one.
# =============================================================
